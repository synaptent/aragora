# Aragora Frontend Dockerfile
# Multi-stage build for optimized production image

# Build stage
FROM node:20.19-alpine AS builder

WORKDIR /app

# Build-time public env (injected into Next.js build)
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws

# Copy TypeScript SDK (local file: dependency in package.json)
COPY sdk/typescript/ /sdk/typescript/
RUN cd /sdk/typescript && npm ci --no-audit --no-fund && npm run build

# Copy package files. The SDK path remains ../../sdk/typescript. Install from
# /app so npm resolves the local SDK dependency to the absolute /sdk/typescript
# copy above.
COPY aragora/live/package.json aragora/live/package-lock.json aragora/live/.npmrc /app/

# Install dependencies from the committed lockfile
RUN cd /app && npm ci

# Copy source code
COPY aragora/live/ /app/

# Build application with standalone output
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_OUTPUT=standalone
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
RUN cd /app && npm run build:local

# Production stage
FROM node:20.19-alpine

WORKDIR /app

# Runtime env defaults (kept for documentation; build-time env is already embedded)
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}

# Copy standalone build
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs \
    && chown -R nextjs:nodejs /app
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Start application
CMD ["node", "server.js"]
