# Aragora API Configuration

# Server-side (private)
ARAGORA_API_URL=http://localhost:8080
ARAGORA_API_KEY=your-api-key-here

# Client-side (public, exposed to browser)
PUBLIC_ARAGORA_API_URL=http://localhost:8080

# Separate local WebSocket listener; omit when the API origin also serves /ws
PUBLIC_ARAGORA_WS_URL=ws://localhost:8765/ws
