# Aragora Live Dashboard Environment Variables
#
# DEVELOPMENT: Copy this file to .env.local and use as-is
# PRODUCTION: Only NEXT_PUBLIC_WS_URL is required (API uses Next.js rewrites)

# =============================================================================
# DEVELOPMENT SETTINGS (localhost)
# =============================================================================

# WebSocket URL for real-time stream
NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws

# API URL for REST endpoints (optional - uses localhost:8080 in dev)
NEXT_PUBLIC_API_URL=http://localhost:8080

# =============================================================================
# PRODUCTION SETTINGS (aragora.ai)
# =============================================================================
# Uncomment these for production deployment:
#
# NEXT_PUBLIC_WS_URL=wss://api.aragora.ai/ws
#
# NOTE: NEXT_PUBLIC_API_URL is NOT needed in production!
# Next.js rewrites in next.config.js proxy /api/* to the backend.
# This avoids CORS issues and simplifies deployment.

# =============================================================================
# SUPABASE (Optional - for history panel)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# OBSERVABILITY (Optional - all remote telemetry disabled unless configured)
# =============================================================================
# Browser Sentry errors; absent means no browser SDK initialization.
# NEXT_PUBLIC_SENTRY_DSN=
# Server/edge Sentry errors and build wrapper; absent means disabled.
# SENTRY_DSN=
# Secret for source-map upload only; absent means uploads are disabled.
# SENTRY_AUTH_TOKEN=
# Optional server/edge environment override; otherwise NODE_ENV.
# SENTRY_ENVIRONMENT=
# Sentry release: explicit value, else Git HEAD at build time, else 'unknown' inside
# a Next build; the package version is used only outside a Next build (e.g. Jest).
# NEXT_PUBLIC_BUILD_SHA=
# PostHog pageviews and capture helper; absent means analytics are disabled.
# NEXT_PUBLIC_POSTHOG_KEY=
# Optional ingestion host; defaults to https://us.i.posthog.com only with a key.
# NEXT_PUBLIC_POSTHOG_HOST=
# Validation/debugging only, off by default: exactly 1 or true sends clear-text
# PostHog payloads to a local capture stub; unset keeps SDK compression on.
# NEXT_PUBLIC_POSTHOG_DISABLE_COMPRESSION=
# OTLP HTTP/protobuf trace collector endpoint (port 4318); absent means tracing is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional trace service name; when set it overrides the aragora-live default.
# OTEL_SERVICE_NAME=
# Local JSON stdout threshold: trace, debug, info, warn, error, fatal or silent.
# Unset/empty means info; any other value falls back to info with one warning.
# LOG_LEVEL=

# Public build-time opt-outs; only true enables each flag (defaults false).
# NEXT_PUBLIC_FLAG_DISABLE_STREAMING=
# NEXT_PUBLIC_FLAG_DISABLE_AUDIENCE=
