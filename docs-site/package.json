{
  "name": "aragora-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Aragora Documentation Portal",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "node scripts/sync-docs.js && docusaurus build && vercel --prod",
    "deploy:preview": "node scripts/sync-docs.js && docusaurus build && vercel",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:duplicates": "jscpd --config .jscpd.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen-api-docs": "docusaurus gen-api-docs aragora",
    "sync-docs": "node scripts/sync-docs.js"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^4.7.1",
    "docusaurus-theme-openapi-docs": "^4.7.1",
    "posthog-docusaurus": "2.0.5",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "jscpd": "5.1.1",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "typescript": "~5.2.2",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ajv": "8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "knip": {
      "yaml": "^2.9.0"
    },
    "minimatch": "10.2.4",
    "qs": "6.15.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.22",
    "yaml": "^1.10.3",
    "js-yaml": "4.3.1",
    "brace-expansion": "^5.0.2",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "openapi-to-postmanv2": {
      "js-yaml": "4.3.1",
      "lodash": "^4.18.0"
    },
    "postman-code-generators": {
      "lodash": "^4.18.0"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
